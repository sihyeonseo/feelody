{
  "framework": null,
  "installCommand": "node --version",
  "buildCommand": "node web/build.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/recommend.mjs": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
